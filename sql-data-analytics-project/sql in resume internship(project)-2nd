create database campusplacementdb;
use campusplacementdb;
create table students (
    studentid int primary key auto_increment,
    studentname varchar(100) not null,
    gender varchar(20),
    department varchar(50) not null,
    cgpa decimal(3,2) check (cgpa between 0 and 10),
    graduationyear year not null,
    city varchar(50),
    phone varchar(15) unique,
    email varchar(100) unique not null,
    placementstatus varchar(30) default 'Not Placed'
);
create table companies (
companyid int primary key auto_increment,
    companyname varchar(100) not null unique,
    industry varchar(50),
    companylocation varchar(100),
    companysize varchar(30),
    minimumcgpa decimal(3,2) check (minimumcgpa between 0 and 10)
);
create table jobroles ( 
    jobroleid int primary key auto_increment, 
    companyid int not null, 
    rolename varchar(100) not null, 
    jobtype varchar(30), 
    minimumcgpa decimal(3,2) check (minimumcgpa between 0 and 10), 
    packagelpa decimal(6,2) check (packagelpa >= 0), 
    vacancies int check (vacancies > 0), 
    constraint fk_jobrole_company 
        foreign key (companyid) 
        references companies(companyid) 
        on delete cascade 
        on update cascade 
);
create table applications (
    applicationid int primary key auto_increment,
    studentid int not null,
    jobroleid int not null,
    applicationdate date not null,
    applicationstatus varchar(30) default 'Applied',
    interviewscore decimal(5,2) check (interviewscore between 0 and 100),
    finalstatus varchar(30) default 'Pending',
    constraint fk_application_student
        foreign key (studentid)
        references students(studentid)
        on delete cascade
        on update cascade,
        constraint fk_application_jobrole
        foreign key (jobroleid)
        references jobroles(jobroleid)
        on delete cascade
        on update cascade
        );
create table skills (
skillid int primary key auto_increment,
skillname varchar(50) not null unique,
skillcategory varchar(50)
);
 create table studentskills ( 
    studentid int, 
    skillid int, 
    skilllevel varchar(30), 
    primary key (studentid, skillid),
    constraint fk_studentskills_student 
        foreign key (studentid) 
        references students(studentid) 
        on delete cascade 
        on update cascade, 
        constraint fk_studentskills_skill 
        foreign key (skillid) 
        references skills(skillid) 
        on delete cascade 
        on update cascade 
);
