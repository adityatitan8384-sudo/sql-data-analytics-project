-- ANALYSIS...........................................................................
select *
from students
where cgpa > 8.5;  -- cgpa above 8.5

select *
from students
where department = 'computer science';  -- computer science students


select studentname, city
from students
where city in ('raipur', 'bhilai', 'nagpur');  -- students from selected cities

select studentname
from students
where studentname like 'a%';  -- names beginning with a

select studentname
from students
where studentname like '%an%';  -- names containing "an"

select studentname, cgpa
from students
where cgpa between 7 and 9;  -- cgpa between 7 and 9

select studentname, email
from students
where phone is null;  -- missing phone numbers

select studentname, phone
from students
where phone is not null; -- students having phone numbers

select studentname, department
from students
where graduationyear = 2027; -- graduating in 2027

select studentname, placementstatus
from students
where placementstatus in ('Placed', 'Shortlisted'); -- placed or shortlisted

select *
from companies
where industry = 'IT Services'; -- it service


select *    -- company and job analysis
from jobroles
where packagelpa > 8;
select rolename, packagelpa
from jobroles
where packagelpa between 5 and 10;
select rolename, vacancies
from jobroles
where vacancies > 3;
select *
from companies
where companyname like 'T%';
select *
from jobroles
where minimumcgpa > 8;
select *
from companies
where companylocation in ('Bengaluru', 'Pune');


-- Aggregation.....
select count(*) as totalstudents
from students; -- total students
select round(avg(cgpa), 2) as averagecgpa
from students; -- average cgpa
select max(cgpa) as highestcgpa
from students; -- highest cgpa
select min(cgpa) as lowestcgpa
from students; -- lowest cgpa
select count(*) as totalcompanies
from companies; -- total companies
select count(*) as totalapplications
from applications; -- total applications
select round(avg(packagelpa), 2) as averagepackage
from jobroles; -- average package
select max(packagelpa) as highestpackage
from jobroles; -- highest package

select
    department,
    count(*) as studentcount,
    round(avg(cgpa), 2) as averagecgpa,
    max(cgpa) as highestcgpa,
    min(cgpa) as lowestcgpa
from students
group by department; -- department wise analysis

select
c.companyname,
    count(j.jobroleid) as numberofroles,
    sum(j.vacancies) as totalvacancies,
    round(avg(j.packagelpa), 2) as averagepackage,
    max(j.packagelpa) as highestpackage
from companies c
join jobroles j
    on c.companyid = j.companyid
group by c.companyid, c.companyname;  -- analysis

-- HAVING............
select 
department, 
count(*) as studentcount 
from students 
group by department 
having count(*) > 5;  -- departments having more than 5 students

select
department,
round(avg(cgpa), 2) as averagecgpa
from students
group by department
having avg(cgpa) > 8;  -- departments with average cgpa above 8

select
c.companyname,
count(j.jobroleid) as rolecount
from companies c
join jobroles j
on c.companyid = j.companyid
group by c.companyid, c.companyname
having count(j.jobroleid) > 2;  -- companies offering more than 2 roles

-- Join analysis...............
select
s.studentname,
c.companyname,
j.rolename,
j.packagelpa,
a.applicationstatus,
a.finalstatus
from students s
join applications a
on s.studentid = a.studentid
join jobroles j
on a.jobroleid = j.jobroleid
join companies c
on j.companyid = c.companyid;      -- complete application details

select          -- every student and their application
s.studentname,
a.applicationid,
a.applicationstatus
from students s
left join applications a
on s.studentid = a.studentid;

select   -- students who have not applied
s.studentid,
s.studentname
from students s
left join applications a
on s.studentid = a.studentid
where a.applicationid is null;

select   -- companies and their roles
c.companyname,
j.rolename,
j.packagelpa,
j.vacancies
from companies c
left join jobroles j
on c.companyid = j.companyid;

select   -- students applying to packages above 8 lpa
s.studentname,
c.companyname,
j.rolename,
j.packagelpa
from students s
join applications a
on s.studentid = a.studentid
join jobroles j
on a.jobroleid = j.jobroleid
join companies c
on j.companyid = c.companyid
where j.packagelpa > 8;

-- recruitment performance
select
c.companyname,
count(a.applicationid) as applications,
sum(case when a.finalstatus = 'selected' then 1 else 0 end) as selected,
sum(case when a.finalstatus = 'rejected' then 1 else 0 end) as rejected,
sum(case when a.finalstatus = 'pending' then 1 else 0 end) as pending,
round(
sum(case when a.finalstatus = 'selected' then 1 else 0 end)
* 100.0 / count(a.applicationid),
        2
    ) as selectionrate
from companies c
join jobroles j
on c.companyid = j.companyid
join applications a
on j.jobroleid = a.jobroleid
group by c.companyid, c.companyname;


select    -- companies with select rate above 20 %
c.companyname,
round(
sum(case when a.finalstatus = 'selected' then 1 else 0 end)
* 100.0 / count(a.applicationid),
        2
    ) as selectionrate
from companies c
join jobroles j
on c.companyid = j.companyid
join applications a
on j.jobroleid = a.jobroleid
group by c.companyid, c.companyname
having
sum(case when a.finalstatus = 'selected' then 1 else 0 end)
* 100.0 / count(a.applicationid) > 20;

-- top students..............................
select   -- top 10 cgpa
studentname,
department,
cgpa
from students
order by cgpa desc, studentname asc
limit 10;
select   -- top interview score
s.studentname,
a.interviewscore
from students s
join applications a
on s.studentid = a.studentid
where a.interviewscore is not null
order by a.interviewscore desc
limit 10;

-- subqueries.............................
