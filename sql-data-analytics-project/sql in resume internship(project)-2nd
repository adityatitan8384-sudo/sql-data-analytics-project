select    -- department with highest average cgpa
department,
round(avg(cgpa), 2) as averagecgpa
from students
group by department
order by averagecgpa desc
limit 1;


select    -- highest paying jb roles
c.companyname,
j.rolename,
j.packagelpa
from companies c
join jobroles j
on c.companyid = j.companyid
order by j.packagelpa desc
limit 5;


select   -- student above university average cgpa
studentname,
department,
cgpa
from students
where cgpa > (
    select avg(cgpa)
    from students
)
order by cgpa desc;


select   -- most competetive job roles
j.rolename,
c.companyname,
count(a.applicationid) as applicants
from jobroles j
join companies c
on j.companyid = c.companyid
left join applications a
on j.jobroleid = a.jobroleid
group by j.jobroleid, j.rolename, c.companyname
order by applicants desc;


select  -- students applying to multiple companies...
s.studentname,
count(distinct c.companyid) as companycount
from students s
join applications a
on s.studentid = a.studentid
join jobroles j
on a.jobroleid = j.jobroleid
join companies c
on j.companyid = c.companyid
group by s.studentid, s.studentname
having count(distinct c.companyid) > 1
order by companycount desc;


select   -- selected students and their package
s.studentname,
c.companyname,
j.rolename,
j.packagelpa
from students s
join applications a
on s.studentid = a.studentid
join jobroles j
on a.jobroleid = j.jobroleid
join companies c
on j.companyid = c.companyid
where a.finalstatus = 'selected'
order by j.packagelpa desc;


select  -- students with high cgpa but rejected applications
s.studentname,
s.cgpa,
c.companyname,
j.rolename,
a.interviewscore,
a.finalstatus
from students s
join applications a
on s.studentid = a.studentid
join jobroles j
on a.jobroleid = j.jobroleid
join companies c
on j.companyid = c.companyid
where s.cgpa >= 8.5
and a.finalstatus = 'rejected';


select   -- most demanded skills
sk.skillname,
count(ss.studentid) as studentshavingskill
from skills sk
join studentskills ss
on sk.skillid = ss.skillid
group by sk.skillid, sk.skillname
order by studentshavingskill desc;


select -- companies with vacancies but low applications
c.companyname,
j.rolename,
j.vacancies,
count(a.applicationid) as applications
from companies c
join jobroles j
on c.companyid = j.companyid
