select avg(packagelpa)
from jobroles
);
select distinct   -- companies above average package
c.companyname
from companies c
join jobroles j
on c.companyid = j.companyid
where j.packagelpa > (
select avg(packagelpa)
from jobroles
);

-- advanced subqueries..............................
select
s.studentname,
count(a.applicationid) as applicationcount
from students s
join applications a
on s.studentid = a.studentid
group by s.studentid, s.studentname
having count(a.applicationid) > (
select avg(applicationcount)
from (
select
studentid,
count(*) as applicationcount
from applications
group by studentid
) as studentapplicationcounts
);

-- skills analysis...
select            -- students with sql
s.studentname,
s.department
from students s
join studentskills ss
on s.studentid = ss.studentid
join skills sk
on ss.skillid = sk.skillid
where sk.skillname = 'sql';

select  -- students with python and sql
s.studentname
from students s
join studentskills ss
on s.studentid = ss.studentid
join skills sk
on ss.skillid = sk.skillid
where sk.skillname in ('sql', 'python')
group by s.studentid, s.studentname
having count(distinct sk.skillname) = 2;

select   -- skills which are most common
sk.skillname,
count(ss.studentid) as studentcount
from skills sk
join studentskills ss
on sk.skillid = ss.skillid
group by sk.skillid, sk.skillname
order by studentcount desc;

select    -- avg cgpa by skill
sk.skillname,
round(avg(s.cgpa), 2) as averagecgpa
from skills sk
join studentskills ss
on sk.skillid = ss.skillid
join students s
on ss.studentid = s.studentid
group by sk.skillid, sk.skillname
order by averagecgpa desc;

-- union .............

select                -- high cgpa
studentid,
studentname,
'high cgpa' as category
from students
where cgpa >= 8.5;

select  -- high interview score
s.studentid,
s.studentname,
'high interview score' as category
from students s
join applications a
on s.studentid = a.studentid
where a.interviewscore >= 85;

select     -- combine using union
studentid,
studentname
from students
where cgpa >= 8.5
union
select
s.studentid,
s.studentname
from students s
join applications a
on s.studentid = a.studentid
where a.interviewscore >= 85;

